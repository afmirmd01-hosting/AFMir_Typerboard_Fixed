<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:background="#E6131822"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Typerboard — AF Mir"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/ovBtnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#9CA3AF"
            android:textSize="16sp"
            android:padding="4dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Auto Nums" android:textColor="#FFFFFF" />
        <Button android:id="@+id/ovBtnNums" android:layout_width="64dp" android:layout_height="40dp" android:text="Off" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Auto Alpha" android:textColor="#FFFFFF" />
        <Button android:id="@+id/ovBtnAlpha" android:layout_width="64dp" android:layout_height="40dp" android:text="On" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Auto Words" android:textColor="#FFFFFF" />
        <Button android:id="@+id/ovBtnWords" android:layout_width="64dp" android:layout_height="40dp" android:text="Off" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="iPhone Drop" android:textColor="#FFFFFF" />
        <Button android:id="@+id/ovBtnIphone" android:layout_width="64dp" android:layout_height="40dp" android:text="On" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
