<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AF Mir Typerboard"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnEnableIme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Enable Typerboard Keyboard"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSelectIme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Select Typerboard Keyboard"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Launch Floating Typerboard Panel"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Custom Auto Alpha Shortcut"
            android:textColor="#4ADE80"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etShortcutKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Key (e.g. s)"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            android:maxLength="1" />

        <EditText
            android:id="@+id/etShortcutVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Auto text (e.g. Hello, ready?)"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSaveShortcut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Shortcut" />
    </LinearLayout>
</ScrollView>
